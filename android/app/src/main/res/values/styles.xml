<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Lets the app draw fully behind a display cutout (camera
             notch/punch-hole) instead of Android reserving a black bar
             around it — this app is landscape-locked, so without this a
             cutout on the "short edge" can letterbox the game with a
             solid bar that looks like a lingering system UI element.
             Combined with MainActivity's hideSystemBars() and the
             existing env(safe-area-inset-*) CSS padding, the game still
             avoids drawing its own UI under the actual cutout — this
             just stops Android from adding an extra bar on top of that.
             Ignored (harmless) below API 28, which is fine since this
             attribute doesn't exist there anyway. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>